# Shared by every location that proxies to the App (see default.conf.template).
# Cloud Run routes requests by Host header, so it must be the App's own
# *.run.app hostname; the original legisia.co host goes in X-Forwarded-Host.
proxy_set_header Host ${APP_UPSTREAM_HOST};
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_ssl_server_name on;
proxy_http_version 1.1;
